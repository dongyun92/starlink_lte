[Unit]
Description=Starlink gRPC-Web Collector
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/pi/starlink_lte
# --ping-interface: Starlink 인터넷 인터페이스 지정 (예: eth0, wlan0)
# 인터페이스 확인: ip route show | grep default
ExecStart=/usr/bin/python3 /home/pi/starlink_lte/starlink/collector/grpc_web_collector.py --control-port 9201 --grpc-host 192.168.100.1 --grpc-port 9200 --interval 0.5 --data-dir /home/hanul/starlink-collect-data --ping-target 8.8.8.8 --ping-interface eth0
Restart=always
RestartSec=1
User=pi
Group=pi

[Install]
WantedBy=multi-user.target
